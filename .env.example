# Supabase — required for accounts, profiles, matches, messages, reports, and blocks
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Site URL — use http://localhost:3000 while developing
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — required only for SaddleMatch Plus checkout and subscription management
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Anthropic — required only for optional AI profile and conversation help
ANTHROPIC_API_KEY=replace_me
